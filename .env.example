# Frontend build-time settings (copy to .env.local for local overrides).

# Base URL of the API. Leave empty when the frontend and the managed Functions
# API are deployed together in the same Static Web App (they share /api).
# Set it only if the frontend is hosted on a different origin, e.g.
#   VITE_API_URL=https://<your-app>.azurestaticapps.net
# and add that frontend's origin to the API's ALLOWED_ORIGINS setting.
VITE_API_URL=
